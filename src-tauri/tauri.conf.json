{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChordLens",
  "version": "0.1.0",
  "identifier": "com.whitney.chordlens",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChordLens",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 28
        },
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Explore chords, notes, and guitar voicings.",
    "longDescription": "A local macOS chord tool with note-to-chord identification, chord formulas, and guitar voicing diagrams.",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "hardenedRuntime": true
    }
  }
}
